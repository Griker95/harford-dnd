ell=23731/valor-de-bloqueo-19\" class=\"q2\">Aumenta el valor de bloqueo de tu escudo en 19 p.</a><!--useEffect:1--></span><!--useText:1--><br><!--useText:0:2--><span id=\"useText2\" class=\"q2\">Equipar: <!--useEffect:0:2--><a href=\"/classic/es/spell=446092/proteccion-gneurostatica\" class=\"q2\">Ofrece protecci\u00f3n contra ciertos tipos de ataques ps\u00edquicos.</a><!--useEffect:2--></span><!--useText:2--><br><!--useText:0:3--><span id=\"useText3\" class=\"q2\">Uso: <!--useEffect:0:3--><a href=\"/classic/es/spell=446382/armonizado-con-el-vacio\" class=\"q2\">Canaliza el poder del Vac\u00edo, lo que otorga inmunidad al miedo durante 15 s.</a> (10 Min Reutilizaci\u00f3n)<!--useEffect:3--></span><!--useText:3--><!--itemEffects:1--><br><span class=\"q\">&quot;Con las mejores piezas del dise\u00f1o original de Ziri y unas cuantas modificaciones adicionales.&quot;</span><br><!--pvpEquip--><!--pvpEquip--></td></tr></table>","tooltip2":"","buff":"","quality":4,"spells":{},"buffspells":{},"completion_category":11}